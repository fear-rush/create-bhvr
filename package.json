{
	"name": "create-bhvr",
	"version": "0.6.4",
	"description": "Create a new bhvr project",
	"keywords": [
		"bun",
		"create",
		"hono",
		"monorepo",
		"react",
		"starter",
		"template",
		"vite"
	],
	"license": "MIT",
	"author": "Steve Simkins",
	"bin": {
		"create-bhvr": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target node && rm -rf dist/templates && cp -r src/templates dist/",
		"start": "bun ./dist/index.js",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "oxlint --disable-nested-config src scripts",
		"lint:check": "oxlint --disable-nested-config src scripts",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"type-check": "tsc --noEmit",
		"sync:base": "bun scripts/sync-base.ts",
		"test:generated": "bun run build && bun scripts/verify-generated.ts",
		"test:auth": "bun run build && bun scripts/verify-auth.ts",
		"test:tools": "bun run build && bun scripts/verify-developer-tools.ts",
		"lint:fix": "oxlint --disable-nested-config --fix src scripts",
		"test:combinations": "bun scripts/check-template-combinations.ts"
	},
	"dependencies": {
		"commander": "15.0.0",
		"consola": "3.4.2",
		"degit": "3.10.1",
		"execa": "10.2.1",
		"fs-extra": "11.4.1",
		"picocolors": "1.1.1",
		"yocto-spinner": "1.2.2"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/degit": "3.10.0",
		"@types/fs-extra": "11.0.4",
		"@types/node": "26.6.6",
		"oxc-parser": "0.156.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"typescript": "7.0.2"
	},
	"overrides": {
		"@types/node": "26.6.6"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22.22.0"
	},
	"packageManager": "bun@1.4.4"
}
